{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "XBAR500 LED Tube (custom fw)",
  "shortName": "XBAR500",
  "categories": ["Pixel Bar"],
  "meta": {
    "authors": ["HfG Schwaebisch Gmuend Prototyping Lab"],
    "createDate": "2026-10-24",
    "lastModifyDate": "2026-10-24"
  },
  "comment": "LED tube with custom ATmega8 firmware tube_fw (DMX512 + RDM).",
  "rdm": {
    "modelId": 1,
    "softwareVersion": "0.5.0"
  },
  "physical": {
    "dimensions": [500, 50, 50],
    "power": 6
  },
  "matrix": {
    "pixelCount": [4, 1, 1]
  },
  "templateChannels": {
    "Red $pixelKey": {
      "capability": { "type": "ColorIntensity", "color": "Red" }
    },
    "Green $pixelKey": {
      "capability": { "type": "ColorIntensity", "color": "Green" }
    },
    "Blue $pixelKey": {
      "capability": { "type": "ColorIntensity", "color": "Blue" }
    }
  },
  "availableChannels": {
    "Red": {
      "capability": { "type": "ColorIntensity", "color": "Red" }
    },
    "Green": {
      "capability": { "type": "ColorIntensity", "color": "Green" }
    },
    "Blue": {
      "capability": { "type": "ColorIntensity", "color": "Blue" }
    },
    "Dimmer": {
      "defaultValue": 255,
      "capability": { "type": "Intensity" }
    }
  },
  "modes": [
    {
      "name": "4x RGB (12 ch)",
      "shortName": "12ch",
      "rdmPersonalityIndex": 1,
      "channels": [
        "Red 1", "Green 1", "Blue 1",
        "Red 2", "Green 2", "Blue 2",
        "Red 3", "Green 3", "Blue 3",
        "Red 4", "Green 4", "Blue 4"
      ]
    },
    {
      "name": "RGB (3 ch)",
      "shortName": "3ch",
      "rdmPersonalityIndex": 2,
      "channels": ["Red", "Green", "Blue"]
    },
    {
      "name": "RGB + Dimmer (4 ch)",
      "shortName": "4ch",
      "rdmPersonalityIndex": 3,
      "channels": ["Red", "Green", "Blue", "Dimmer"]
    },
    {
      "name": "4x RGB + Dimmer (13 ch)",
      "shortName": "13ch",
      "rdmPersonalityIndex": 4,
      "channels": [
        "Red 1", "Green 1", "Blue 1",
        "Red 2", "Green 2", "Blue 2",
        "Red 3", "Green 3", "Blue 3",
        "Red 4", "Green 4", "Blue 4",
        "Dimmer"
      ]
    }
  ]
}
