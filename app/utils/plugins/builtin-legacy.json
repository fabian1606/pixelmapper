  {
    "hash": "sha256:792e8836d580e06fd98ddad53b69af615bc0106009892c1b2d55fde57cc87a6b",
    "alias": "@pixelmapper/color-adjust",
    "version": "2.0.0",
    "params": [
      {
        "key": "mode",
        "type": "enum",
        "options": [
          "palette",
          "shift"
        ],
        "optionLabels": [
          "Palette",
          "Shift"
        ],
        "default": "shift",
        "label": "Mode",
        "tier": "primary",
        "description": "Palette: colors from a gradient. Shift: swing the fixtures' own hue."
      },
      {
        "key": "palette",
        "type": "gradient",
        "label": "Palette",
        "tier": "primary",
        "when": {
          "mode": "palette"
        },
        "default": {
          "stops": [
            {
              "pos": 0,
              "color": {
                "r": 1,
                "g": 0,
                "b": 0
              }
            },
            {
              "pos": 0.5,
              "color": {
                "r": 0,
                "g": 0,
                "b": 1
              }
            }
          ]
        }
      },
      {
        "key": "arrange",
        "type": "enum",
        "options": [
          "gradient",
          "alternate"
        ],
        "optionLabels": [
          "Gradient",
          "Alternate"
        ],
        "default": "gradient",
        "label": "Arrange",
        "tier": "primary",
        "when": {
          "mode": "palette"
        },
        "description": "Gradient: colors follow the distribution. Alternate: neighbours in the order get the next color."
      },
      {
        "key": "transition",
        "type": "number",
        "min": 0,
        "max": 1,
        "default": 0,
        "label": "Transition",
        "tier": "primary",
        "when": {
          "mode": "palette",
          "arrange": "gradient"
        },
        "description": "Hard steps (0) to soft blends (1)."
      },
      {
        "key": "hueShift",
        "type": "number",
        "min": -180,
        "max": 180,
        "default": 0,
        "label": "Hue shift",
        "unit": "\u00b0",
        "tier": "hidden"
      },
      {
        "key": "hueRange",
        "type": "number",
        "min": 0,
        "max": 180,
        "default": 40,
        "label": "Hue range",
        "unit": "\u00b0",
        "tier": "hidden"
      },
      {
        "key": "saturation",
        "type": "number",
        "min": 0,
        "max": 2,
        "default": 1,
        "label": "Saturation",
        "tier": "primary",
        "when": {
          "mode": "shift"
        }
      },
      {
        "key": "satDip",
        "type": "number",
        "min": 0,
        "max": 1,
        "default": 0,
        "label": "White dip",
        "tier": "advanced",
        "when": {
          "mode": "shift"
        },
        "description": "How far the profile's peak fades toward white."
      },
      {
        "key": "profile",
        "type": "curve",
        "label": "Profile",
        "tier": "advanced",
        "when": {
          "mode": "shift"
        },
        "description": "How the hue swings over the distance from the moving position.",
        "domain": "signed",
        "axis": "fixtures",
        "range": "unipolar",
        "shapes": [
          "wave",
          "dot",
          "bar",
          "wedge",
          "flash"
        ],
        "default": {
          "shape": "wave",
          "args": {}
        }
      },
      {
        "key": "motion",
        "type": "curve",
        "label": "Motion",
        "tier": "primary",
        "description": "Where the colors are during one pass.",
        "domain": "cycle",
        "axis": "beats",
        "shapes": [
          "run",
          "pingpong",
          "step",
          "hold",
          "ease"
        ],
        "default": {
          "shape": "run",
          "args": {}
        }
      }
    ]
  },
