{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixelmapper",
  "version": "../package.json",
  "identifier": "app.pixelmapper.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:nuxt",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run scripts/tauri/firmware-bundle.ts && bun run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pixelmapper",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/firmware/*": "resources/firmware/"
    }
  }
}
