{
  "name": "pixelmapper",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "extensions/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently -n nuxt,canvas,core,artnet -c cyan,yellow,green,magenta \"nuxt dev\" \"cargo watch -C rs-engine/canvas -s 'wasm-pack build --target web --out-dir ../../node_modules/rs-engine-canvas'\" \"cargo watch -C rs-engine/core -s 'wasm-pack build --target web --out-dir ../../node_modules/rs-engine-core'\" \"bun run tools/artnet-bridge/index.ts\"",
    "artnet-bridge": "bun run tools/artnet-bridge/index.ts",
    "dev:nuxt": "nuxt dev",
    "dev:wasm:canvas": "cargo watch -C rs-engine/canvas -s 'wasm-pack build --target web --out-dir ../../node_modules/rs-engine-canvas'",
    "dev:wasm:core": "cargo watch -C rs-engine/core -s 'wasm-pack build --target web --out-dir ../../node_modules/rs-engine-core'",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && ./scripts/setup-ofl.sh",
    "release": "bun run scripts/release.ts",
    "flash": "bun run scripts/flash.ts",
    "flash:ws": "bun run scripts/flash.ts ws",
    "flash:ws-eth": "bun run scripts/flash.ts ws-eth",
    "flash:p4": "bun run scripts/flash.ts p4",
    "flash:bridge": "bun run scripts/flash.ts bridge",
    "build:ws": "bun run scripts/flash.ts ws --build",
    "build:ws-eth": "bun run scripts/flash.ts ws-eth --build",
    "build:p4": "bun run scripts/flash.ts p4 --build",
    "build:bridge": "bun run scripts/flash.ts bridge --build",
    "monitor:ws": "bun run scripts/flash.ts ws --monitor",
    "monitor:ws-eth": "bun run scripts/flash.ts ws-eth --monitor",
    "monitor:p4": "bun run scripts/flash.ts p4 --monitor",
    "monitor:bridge": "bun run scripts/flash.ts bridge --monitor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.0.6",
    "@pinia/nuxt": "^0.11.3",
    "@pixelmapper/extension-api": "workspace:*",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esptool-js": "^0.6.0",
    "lucide-vue-next": "^0.575.0",
    "nuxt": "^4.3.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.9.3",
    "rs-engine-canvas": "./rs-engine/canvas/pkg",
    "rs-engine-core": "./rs-engine/core/pkg",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@itmr.dev/bump": "^1.5.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^25.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "version": "0.1.27"
}
