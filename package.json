{
  "name": "pixelmapper",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "extensions/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "bun run build:plugins && bun run build:extensions && nuxt build",
    "dev": "bun run build:wasm && bun run build:extensions && concurrently -n nuxt,canvas,core,pmnet-bridge,artnet-legacy,plugins -c cyan,yellow,green,magenta,gray,blue \"nuxt dev\" \"cargo watch --postpone -C rs-engine/canvas -s 'wasm-pack build --target web --out-dir ../../node_modules/rs-engine-canvas'\" \"cargo watch --postpone -C rs-engine/core -s 'wasm-pack build --target web --out-dir ../../node_modules/rs-engine-core'\" \"bun run scripts/start-pmnet-bridge.ts\" \"bun run tools/artnet-bridge/index.ts\" \"bun run scripts/build-plugins.ts --watch\"",
    "pmnet-bridge": "bun run scripts/start-pmnet-bridge.ts",
    "artnet-bridge": "bun run tools/artnet-bridge/index.ts",
    "dev:nuxt": "bun run build:plugins && bun run build:extensions && nuxt dev",
    "dev:wasm:canvas": "cargo watch -C rs-engine/canvas -s 'wasm-pack build --target web --out-dir ../../node_modules/rs-engine-canvas'",
    "dev:wasm:core": "cargo watch -C rs-engine/core -s 'wasm-pack build --target web --out-dir ../../node_modules/rs-engine-core'",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "generate": "bun run build:plugins && bun run build:extensions && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && ./scripts/setup-ofl.sh",
    "release": "bun run scripts/release.ts",
    "flash": "bun run scripts/flash.ts",
    "flash:ws": "bun run scripts/flash.ts ws",
    "flash:ws-eth": "bun run scripts/flash.ts ws-eth",
    "flash:p4": "bun run scripts/flash.ts p4",
    "flash:bridge": "bun run scripts/flash.ts bridge",
    "build:ws": "bun run scripts/flash.ts ws --build",
    "build:ws-eth": "bun run scripts/flash.ts ws-eth --build",
    "build:p4": "bun run scripts/flash.ts p4 --build",
    "build:bridge": "bun run scripts/flash.ts bridge --build",
    "monitor:ws": "bun run scripts/flash.ts ws --monitor",
    "monitor:ws-eth": "bun run scripts/flash.ts ws-eth --monitor",
    "monitor:p4": "bun run scripts/flash.ts p4 --monitor",
    "monitor:bridge": "bun run scripts/flash.ts bridge --monitor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:artnet": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "nuxt typecheck",
    "typecheck:extensions": "vue-tsc --noEmit -p tsconfig.extensions.json",
    "lint": "eslint extensions",
    "check:extensions": "bun run scripts/check-extensions.ts",
    "build:plugins": "bun run scripts/build-plugins.ts",
    "build:extensions": "bun run scripts/build-extensions.ts",
    "check:zero-extensions": "bun run scripts/check-zero-extensions.ts",
    "docs:ai": "bun run scripts/generate-ai-docs.ts",
    "build:wasm": "cd rs-engine/canvas && wasm-pack build --target web --out-dir ../../node_modules/rs-engine-canvas && cd ../core && wasm-pack build --target web --out-dir ../../node_modules/rs-engine-core"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.0.6",
    "@pinia/nuxt": "^0.11.3",
    "@pixelmapper/extension-api": "workspace:*",
    "@pixelmapper/plugin-toolchain": "workspace:*",
    "@tanstack/vue-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esptool-js": "^0.6.0",
    "fflate": "^0.8.3",
    "lucide-vue-next": "^0.575.0",
    "nuxt": "^4.3.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.9.3",
    "rs-engine-canvas": "./rs-engine/canvas/pkg",
    "rs-engine-core": "./rs-engine/core/pkg",
    "semver": "^7.8.5",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@itmr.dev/bump": "^1.5.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@tailwindcss/vite": "^4.2.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@types/three": "^0.185.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "version": "0.1.27"
}
