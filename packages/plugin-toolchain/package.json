{
  "name": "@pixelmapper/plugin-toolchain",
  "version": "0.1.0",
  "description": "Isomorphic compiler, instrumentation, validation and hashing for content plugins.",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./params": "./src/params.ts",
    "./curve-shapes": "./src/curve-shapes.ts",
    "./manifest": "./src/manifest.ts",
    "./hash": "./src/hash.ts",
    "./runtime": "./src/runtime.ts",
    "./types": "./src/types.ts",
    "./ui": "./src/ui.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:sdk": "bun run scripts/gen-sdk-sources.ts"
  },
  "dependencies": {
    "assemblyscript": "0.28.20",
    "semver": "7.8.5",
    "sucrase": "3.35.1"
  },
  "peerDependencies": {
    "@pixelmapper/extension-api": "workspace:*"
  }
}
