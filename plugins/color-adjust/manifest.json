{
  "schema": 1,
  "kind": "modifier",
  "alias": "@pixelmapper/color-adjust",
  "name": "Color Adjust",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "description": "Shifts hue and scales saturation of the fixtures' current color, optionally cycling hue/saturation with a waveform over the modifier phase (hue ± hue range, saturation ± saturation range). Near-black colors keep their hue.",
  "signatures": ["rgb"],
  "output": "absolute",
  "params": [
    { "key": "hueShift", "type": "number", "min": -180, "max": 180, "default": 0, "label": "Hue shift", "unit": "°" },
    { "key": "saturation", "type": "number", "min": 0, "max": 2, "default": 1, "label": "Saturation" },
    { "key": "hueRange", "type": "number", "min": 0, "max": 180, "default": 0, "label": "Hue cycle", "unit": "°", "group": "Cycle" },
    { "key": "satRange", "type": "number", "min": 0, "max": 1, "default": 0, "label": "Saturation cycle", "group": "Cycle" },
    { "key": "shape", "type": "enum", "options": ["sine", "square", "triangle", "sawtooth", "bounce", "ramp", "smooth"], "optionLabels": ["Sine", "Square", "Triangle", "Sawtooth", "Bounce", "Ramp", "Smooth"], "default": "sine", "label": "Cycle shape", "group": "Cycle" },
    { "key": "shapeParam", "type": "number", "min": 0, "max": 1, "default": 0.5, "label": "Shape amount", "group": "Cycle" }
  ]
}
